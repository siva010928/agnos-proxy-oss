# ─────────────────────────────────────────────────────────────────────────────
# Agnos Proxy - provider credentials template (SECRET-FREE)
#
# Copy to `.env` (repo root) and fill in ONLY the providers you want to exercise.
# The gateway and the sanity suite (scripts/sanity) read the SAME variables - a
# provider whose credentials are absent is SKIPPED, never failed.
#
#   cp providers.env-template .env   # then edit .env
#   python -m scripts.sanity all
#
# Nothing here is a secret; real values live only in your local .env (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (chat only; no embeddings API) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── AWS Bedrock (chat + Titan/Cohere embeddings) ───────────────────────────
# Three auth modes - set ONE:
#   1) static keys:  AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN)
#   2) bearer key:   AWS_BEDROCK_API_KEY  (exported to AWS_BEARER_TOKEN_BEDROCK)
#   3) SSO profile:  AWS_PROFILE_NAME     (run `aws sso login --profile <name>` first)
# AWS_REGION_NAME MUST match the model id's regional prefix
#   us.* -> us-east-1 | eu.* -> eu-west-1 | ap.* -> ap-northeast-1 | au.* -> ap-southeast-2 | global.* -> any
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=
AWS_BEDROCK_API_KEY=
AWS_PROFILE_NAME=
AWS_REGION_NAME=us-east-1
AWS_MODEL_NAME=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_EMBEDDINGS_MODEL_NAME=amazon.titan-embed-text-v2:0

# ── Google Gemini - AI Studio (chat + embeddings) ──────────────────────────
GEMINI_API_KEY=...
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_EMBEDDING_MODEL=gemini-embedding-001

# ── Google Vertex AI (service-account; chat + embeddings) ──────────────────
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# ── OpenAI (chat + embeddings) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ── Azure OpenAI (chat + embeddings; `model` = deployment name) ────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── LiteLLM proxy (OpenAI-compatible passthrough) ──────────────────────────
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=

# ── Local OpenAI-compatible servers (Ollama / vLLM / LM Studio) ────────────
OLLAMA_BASE_URL=http://localhost:11434
HOSTED_VLLM_BASE_URL=http://127.0.0.1:1234/v1
