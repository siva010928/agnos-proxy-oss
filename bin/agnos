#!/bin/sh
# agnos - tiny CLI wrapper around the Agnos Proxy quickstart stack.
#
# A thin, low-maintenance shim over `docker compose` for the prebuilt-image quickstart
# in the current directory. Run it from your install dir (the one holding
# docker-compose.yml + .env) or from a repo clone (uses deploy/docker-compose.quickstart.yml).
#
#   agnos up               start the stack (pull the published image)
#   agnos down             stop the stack
#   agnos logs [service]   follow logs (all services, or one, e.g. gateway)
#   agnos status           compose ps + gateway /health
#   agnos update           pull the latest image and restart
#   agnos config           open .env in $EDITOR
#   agnos open             open the dashboard in your browser
#   agnos version          print the gateway + CLI version
#   agnos help             show this help
set -eu

CLI_VERSION="0.2.0"
RAW_BASE="https://raw.githubusercontent.com/siva010928/agnos-proxy-oss/main"
INSTALL_DOCS="https://github.com/siva010928/agnos-proxy-oss/blob/main/docs/INSTALL.md"

# ── output helpers ────────────────────────────────────────────────────────────
die() { printf 'agnos: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'EOF'
agnos - manage the Agnos Proxy quickstart stack

Usage: agnos <command> [args]

Commands:
  init             Create a .env (strong secrets) + compose file for a fresh install
  up               Start the stack (docker compose up -d, pulling the image)
  down             Stop the stack (docker compose down)
  logs [service]   Follow logs for all services, or one (e.g. agnos logs gateway)
  status           Show container status + gateway /health
  update           Pull the latest image and restart
  config           Open .env in $EDITOR
  open             Open the dashboard in the default browser
  version          Print the gateway version (from /health) + this CLI's version
  help             Show this help

Run it from your install directory (docker-compose.yml + .env) or a repo clone.
Docs: https://github.com/siva010928/agnos-proxy-oss/blob/main/docs/INSTALL.md
EOF
}

# ── resolve the docker compose command (v2 plugin preferred) ──────────────────
resolve_dc() {
  if [ -n "${DC:-}" ]; then return 0; fi
  command -v docker >/dev/null 2>&1 || die "docker not found. See docs/INSTALL.md"
  if docker compose version >/dev/null 2>&1; then
    DC="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then
    DC="docker-compose"
  else
    die "Docker Compose not found. Install the Compose v2 plugin. See docs/INSTALL.md"
  fi
}

# ── resolve the compose file + its co-located .env ────────────────────────────
# Prefer ./docker-compose.yml (installer layout); fall back to the in-repo
# deploy/docker-compose.quickstart.yml so it also works from a clone. The .env
# lives next to the compose file (that is where compose resolves env_file: .env).
resolve_compose() {
  if [ -n "${COMPOSE_FILE:-}" ]; then return 0; fi
  if [ -f docker-compose.yml ]; then
    COMPOSE_FILE="docker-compose.yml"
  elif [ -f deploy/docker-compose.quickstart.yml ]; then
    COMPOSE_FILE="deploy/docker-compose.quickstart.yml"
  else
    die "no compose file here. Run the installer first (docs/INSTALL.md) or cd to your install dir."
  fi
  ENV_FILE="$(dirname "$COMPOSE_FILE")/.env"
}

# ── best-effort dashboard port (does not require a compose file) ───────────────
resolve_port() {
  if [ -n "${PORT:-}" ]; then return 0; fi
  ef=""
  for cand in "${ENV_FILE:-}" ".env" "deploy/.env"; do
    [ -n "$cand" ] && [ -f "$cand" ] && { ef="$cand"; break; }
  done
  PORT=""
  if [ -n "$ef" ]; then
    PORT="$(grep -E '^GATEWAY_PORT=' "$ef" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
  fi
  [ -n "$PORT" ] || PORT=8090
}

# ── subcommands ───────────────────────────────────────────────────────────────
# ── init: generate a .env (strong secrets) + compose for a fresh install dir ───
# Mirrors the install.sh interactive wizard. POSIX-sh; secrets via openssl. Refuses
# to clobber an existing .env without --force. Non-interactive (no TTY / --no-input)
# keeps secure defaults: engine=echo, login required, port 8090.
rand_urlsafe() { openssl rand -base64 "${1:-32}" | tr '+/' '-_' | tr -d '='; }

cmd_init() {
  force=0; target="."; engine=""; port=""; preview=""; no_input=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force)             force=1 ;;
      --dir)               shift; target="${1:-.}" ;;
      --engine)            shift; engine="${1:-}" ;;
      --port)              shift; port="${1:-}" ;;
      --preview)           preview=1 ;;
      --no-input|--yes|-y) no_input=1 ;;
      -h|--help)           printf 'agnos init [--dir DIR] [--force] [--engine E] [--port P] [--preview] [--no-input]\n'; return 0 ;;
      *)                   die "init: unknown option '$1' (see: agnos init --help)" ;;
    esac
    shift || true
  done

  command -v openssl >/dev/null 2>&1 || die "openssl not found (needed to generate secrets). See $INSTALL_DOCS"
  mkdir -p "$target" 2>/dev/null || true
  env_file="$target/.env"
  if [ -f "$env_file" ] && [ "$force" != "1" ]; then
    die ".env already exists at $env_file (re-run with --force to overwrite)"
  fi

  ENGINE_CHOICE="echo"; PREVIEW_CHOICE="false"; PORT_CHOICE="8090"; PROVIDER_ENV=""
  [ -n "$engine" ] && ENGINE_CHOICE="$engine"
  [ -n "$port" ]   && PORT_CHOICE="$port"
  [ "$preview" = "1" ] && PREVIEW_CHOICE="true"

  if [ -t 0 ] && [ "$no_input" != "1" ]; then
    if [ -z "$engine" ]; then
      printf '  Engine  1) echo - no keys, demo   2) direct - real providers   3) sidecar (bifrost|litellm|portkey)\n'
      printf '  Choose [1]: '; read -r _e || _e=""
      case "$_e" in
        2) ENGINE_CHOICE="direct" ;;
        3) printf '    which sidecar (bifrost|litellm|portkey) [bifrost]: '; read -r _s || _s=""; ENGINE_CHOICE="${_s:-bifrost}" ;;
        *) ENGINE_CHOICE="echo" ;;
      esac
    fi
    if [ "$ENGINE_CHOICE" != "echo" ]; then
      printf '  Provider keys (optional - leave blank to skip and add to .env later):\n'
      for _pair in "ANTHROPIC_API_KEY:Anthropic" "OPENAI_API_KEY:OpenAI" "GEMINI_API_KEY:Gemini"; do
        _k="${_pair%%:*}"; _label="${_pair##*:}"
        printf '    %s: ' "$_label"; read -r _v || _v=""
        [ -n "$_v" ] && PROVIDER_ENV="${PROVIDER_ENV}${_k}=${_v}
"
      done
    fi
    if [ -z "$preview" ]; then
      printf '  Require login?  1) yes - generate a strong admin password [default]   2) no - open dashboard (preview)\n'
      printf '  Choose [1]: '; read -r _m || _m=""
      case "$_m" in 2) PREVIEW_CHOICE="true" ;; *) PREVIEW_CHOICE="false" ;; esac
    fi
    if [ -z "$port" ]; then
      printf '  Host port [8090]: '; read -r _p || _p=""; PORT_CHOICE="${_p:-8090}"
    fi
  fi

  MASTER_KEY="$(rand_urlsafe 32)"
  ADMIN_TOKEN="$(rand_urlsafe 32)"
  SESS_SECRET="$(rand_urlsafe 32)"
  ADMIN_PASS="$(rand_urlsafe 18)"

  umask 077
  cat > "$env_file" <<EOF
# Agnos Proxy - generated by 'agnos init'. Secrets below are random and unique to
# this install. Keep this file private; never commit it.

# ── Backend engine: echo | direct | bifrost | litellm | portkey ──
ENGINE=$ENGINE_CHOICE

# With PREVIEW_MODE=false the gateway requires login and refuses shipped-default
# secrets - which is why the strong secrets below are generated.
PREVIEW_MODE=$PREVIEW_CHOICE
GATEWAY_PORT=$PORT_CHOICE

# ── Secrets (auto-generated - do not share) ──
GATEWAY_MASTER_KEY=$MASTER_KEY
PLATFORM_ADMIN_TOKEN=$ADMIN_TOKEN
SESSION_SECRET=$SESS_SECRET

# ── Dashboard login ──
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=$ADMIN_PASS

# ── Provider keys (only needed when ENGINE=direct or a sidecar) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
EOF
  [ -n "$PROVIDER_ENV" ] && printf '%s' "$PROVIDER_ENV" >> "$env_file"
  printf 'agnos: wrote %s (engine=%s, login=%s, port=%s)\n' "$env_file" "$ENGINE_CHOICE" \
    "$([ "$PREVIEW_CHOICE" = false ] && echo required || echo open-preview)" "$PORT_CHOICE"

  # Ensure a compose file exists next to the .env; fetch the quickstart if missing.
  if [ ! -f "$target/docker-compose.yml" ] && [ ! -f "$target/deploy/docker-compose.quickstart.yml" ]; then
    if curl -fsSL "$RAW_BASE/deploy/docker-compose.quickstart.yml" -o "$target/docker-compose.yml" 2>/dev/null; then
      printf 'agnos: fetched docker-compose.yml (quickstart)\n'
    else
      printf 'agnos: no compose file yet - run from a repo clone or see %s\n' "$INSTALL_DOCS" >&2
    fi
  fi

  [ "$PREVIEW_CHOICE" = "false" ] && printf '  Admin login: user=admin  password=%s\n' "$ADMIN_PASS"
  if [ "$target" = "." ]; then
    printf 'Next: agnos up\n'
  else
    printf 'Next: (cd %s && agnos up)\n' "$target"
  fi
}

cmd_up() {
  resolve_dc; resolve_compose
  $DC -f "$COMPOSE_FILE" up -d --pull always
  resolve_port
  printf 'agnos: stack started. Dashboard: http://localhost:%s/\n' "$PORT"
}

cmd_down() {
  resolve_dc; resolve_compose
  $DC -f "$COMPOSE_FILE" down
}

cmd_logs() {
  resolve_dc; resolve_compose
  # Optional single service name passed through (e.g. gateway, postgres, redis).
  if [ "$#" -gt 0 ]; then
    $DC -f "$COMPOSE_FILE" logs -f "$@"
  else
    $DC -f "$COMPOSE_FILE" logs -f
  fi
}

cmd_status() {
  resolve_dc; resolve_compose; resolve_port
  $DC -f "$COMPOSE_FILE" ps
  printf '\nHealth (http://localhost:%s/health):\n' "$PORT"
  if curl -fsS --max-time 3 "http://localhost:$PORT/health" 2>/dev/null; then
    printf '\n'
  else
    printf '  unreachable - is the stack up? (agnos up)\n'
  fi
}

cmd_update() {
  resolve_dc; resolve_compose
  $DC -f "$COMPOSE_FILE" pull
  $DC -f "$COMPOSE_FILE" up -d
  printf 'agnos: updated to the latest image.\n'
}

cmd_config() {
  resolve_compose
  [ -f "$ENV_FILE" ] || die "no .env next to $COMPOSE_FILE. Run the installer first (docs/INSTALL.md)."
  editor="${EDITOR:-}"
  if [ -z "$editor" ]; then
    if command -v nano >/dev/null 2>&1; then editor="nano"; else editor="vi"; fi
  fi
  exec "$editor" "$ENV_FILE"
}

cmd_open() {
  resolve_port
  url="http://localhost:$PORT/"
  if command -v open >/dev/null 2>&1; then
    open "$url"                     # macOS
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"                 # Linux
  else
    printf 'Open this in your browser: %s\n' "$url"
  fi
}

cmd_version() {
  resolve_port
  gw="$(curl -fsS --max-time 3 "http://localhost:$PORT/health" 2>/dev/null \
        | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' || true)"
  if [ -n "$gw" ]; then
    printf 'gateway: %s\n' "$gw"
  else
    printf 'gateway: unreachable (start it with: agnos up)\n'
  fi
  printf 'agnos CLI: %s\n' "$CLI_VERSION"
}

# ── dispatch ──────────────────────────────────────────────────────────────────
cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true
case "$cmd" in
  init)           cmd_init "$@" ;;
  up)             cmd_up ;;
  down)           cmd_down ;;
  logs)           cmd_logs "$@" ;;
  status|ps)      cmd_status ;;
  update|upgrade) cmd_update ;;
  config|env)     cmd_config ;;
  open)           cmd_open ;;
  version)        cmd_version ;;
  help|-h|--help) usage ;;
  *)              printf 'agnos: unknown command "%s"\n\n' "$cmd" >&2; usage; exit 1 ;;
esac
