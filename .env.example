# ── Gateway server ──
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8090
GATEWAY_LOG_LEVEL=INFO

# ── Backend engine: bifrost (default) | litellm | portkey | direct | echo ──
ENGINE=bifrost
BIFROST_URL=http://localhost:8099
PORTKEY_URL=http://localhost:8787
LITELLM_ENGINE_URL=http://localhost:4100

# ── Engine image versions (see docs/ENGINES.md - "Engine versions") ──
# Docker image tags for the sidecar engines. Default :latest; pin a release for
# reproducibility. LiteLLM engine version is a Docker build-arg (LITELLM_VERSION,
# default 1.83.14): docker compose build --build-arg LITELLM_VERSION=1.83.14 litellm-engine
BIFROST_VERSION=latest
PORTKEY_VERSION=latest

# ── Governance datastore (Postgres default) ──
GOVERNANCE_DB_URL=postgresql+asyncpg://agnos:agnos@localhost:5433/agnos_gateway

# ── Master encryption key (envelope encryption for workspace creds) ──
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_MASTER_KEY=

# ── Kafka (optional governance bus; empty = disabled) ──
KAFKA_BROKERS=
KAFKA_TOPIC=agnos-proxy.governance.v1

# ── Provider credentials (seed source of truth; synced into Bifrost) ──
ANTHROPIC_API_KEY=sk-ant-...
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION_NAME=us-east-1
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Demo workspace API keys ──
AGNOS_GATEWAY_URL=http://localhost:8090/v1
WS_KEY_PRIMARY=gw-key-primary-001
WS_KEY_SECONDARY=gw-key-secondary-001
WS_KEY_SECURE=gw-key-secure-001
WS_KEY_GEMINI=gw-key-gemini-001

# ── Redis (distributed rate-limit across replicas) ──
REDIS_URL=
INSTANCE_ID=gw-1

# ── RBAC / SSO ──
# Generate strong values for any login-protected deployment. With PREVIEW_MODE=false
# the gateway REFUSES TO START while these are left at the shipped defaults.
#   PLATFORM_ADMIN_TOKEN / SESSION_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_ADMIN_TOKEN=
SESSION_SECRET=
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8090/auth/sso/callback

# ── Governance / OTel ──
GOVERNANCE_MODE=full
OTEL_CONSOLE=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Demo / playground ──
# PREVIEW_MODE=true opens the dashboard without a login wall (demo convenience).
PREVIEW_MODE=true
# PLAYGROUND_MODE=true marks this as a public prototype (UI shows a "prototype" ribbon).
# For a public playground run it with ENGINE=echo and NO real provider keys -> zero-cost.
PLAYGROUND_MODE=false
